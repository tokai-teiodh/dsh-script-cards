{
  "name": "dsh-script-cards",
  "version": "0.1.0-alpha.5",
  "private": true,
  "description": "DSH 剧本档案面板：把项目里的卡片排成方片网格和两级分支画布，拖动、连线、染色，改动直接写回卡片文件。Card grid and branch canvas for a project's Markdown cards inside DeepSeek Harness; edits go straight back to the files.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs --check && node tests/host.mjs && node tests/smoke.mjs",
    "check": "node scripts/build.mjs --check && node --check lib/index.js && node --check lib/typert.js && node --check lib/client.js && node tests/host.mjs && node tests/smoke.mjs",
    "visual": "node tests/visual.mjs --probe"
  },
  "license": "MIT",
  "author": "tokai-teiodh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tokai-teiodh/dsh-script-cards.git"
  },
  "homepage": "https://github.com/tokai-teiodh/dsh-script-cards#readme",
  "bugs": {
    "url": "https://github.com/tokai-teiodh/dsh-script-cards/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "script",
    "screenplay",
    "writing",
    "cards",
    "branching",
    "canvas",
    "typert"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "versionTag": "v0.1.0-alpha.5",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
